{
  "manifest_version": 3,
  "name": "Kreis Tab Switcher",
  "version": "0.5.2",
  "description": "Connect a Chromium browser profile to the Kreis Windows radial launcher.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus"
  ],
  "externally_connectable": {
    "ids": ["mpognobbkildjkofajifpdfhcoklimli"]
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kreis",
    "default_popup": "popup.html"
  }
}
