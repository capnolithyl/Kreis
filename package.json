{
  "name": "kreis",
  "private": true,
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check:extension": "node --check extension/background.js && node --check extension/popup.js && node --check extension/tab-finder.js && node --test extension/tab-finder.test.js",
    "check:title-filter": "node --test tests/title-filter.test.mjs",
    "check:groups": "node --test tests/group-hierarchy.test.mjs",
    "check:wheel-drag": "node --test tests/group-drag-drop.test.mjs",
    "check:hub-drag": "node --test tests/hub-drag.test.mjs",
    "check:wheel-context": "node --test tests/wheel-context.test.mjs",
    "check:wheel-color": "node --test tests/wheel-color.test.mjs",
    "check:context": "node --test tests/context-add.test.mjs",
    "check:chatgpt-tabs": "node --test tests/chatgpt-tab-matching.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
